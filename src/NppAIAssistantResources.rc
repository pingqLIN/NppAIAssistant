#include <windows.h>
#include "NppAIAssistantResources.h"
#include "NppAIAssistantVersion.h"

IDD_AIASSISTANT_PANEL DIALOGEX 0, 0, 280, 300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "AI Assistant"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    COMBOBOX        IDC_AI_PROVIDER_COMBO, 5, 7, 50, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AI_MODEL_COMBO, 58, 7, 100, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sign in", IDC_AI_COPILOT_SIGNIN_BUTTON, 132, 6, 30, 14
    PUSHBUTTON      "A+", IDC_AI_FONT_INCREASE_BUTTON, 166, 6, 18, 14
    PUSHBUTTON      "A-", IDC_AI_FONT_DECREASE_BUTTON, 186, 6, 18, 14
    PUSHBUTTON      "Settings", IDC_AI_SETTINGS_BUTTON, 208, 6, 35, 14
    PUSHBUTTON      "Clear", IDC_AI_CLEAR_BUTTON, 246, 6, 28, 14

    EDITTEXT        IDC_AI_CHAT_HISTORY, 5, 26, 270, 230, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    EDITTEXT        IDC_AI_INPUT_EDIT, 5, 260, 220, 35, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER
    PUSHBUTTON      "Send", IDC_AI_SEND_BUTTON, 230, 260, 45, 35
END

IDD_AIASSISTANT_SETTINGS DIALOGEX 0, 0, 380, 650
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI Assistant Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "OpenAI API Key:", IDC_OPENAI_KEY_LABEL, 10, 15, 72, 10
    EDITTEXT        IDC_OPENAI_KEY_EDIT, 88, 12, 280, 14, ES_AUTOHSCROLL | ES_PASSWORD

    LTEXT           "Gemini API Key:", IDC_GEMINI_KEY_LABEL, 10, 35, 72, 10
    EDITTEXT        IDC_GEMINI_KEY_EDIT, 88, 32, 280, 14, ES_AUTOHSCROLL | ES_PASSWORD

    LTEXT           "Claude API Key:", IDC_CLAUDE_KEY_LABEL, 10, 55, 72, 10
    EDITTEXT        IDC_CLAUDE_KEY_EDIT, 88, 52, 280, 14, ES_AUTOHSCROLL | ES_PASSWORD

    GROUPBOX        "Default Provider and Connection", IDC_DEFAULT_PROVIDER_GROUP, 10, 82, 360, 132
    LTEXT           "Select default AI provider:", IDC_DEFAULT_PROVIDER_LABEL, 20, 98, 110, 10
    COMBOBOX        IDC_DEFAULT_PROVIDER_COMBO, 140, 96, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Language:", IDC_UI_LANGUAGE_LABEL, 20, 118, 90, 10
    COMBOBOX        IDC_UI_LANGUAGE_COMBO, 140, 116, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Require Ctrl+Enter to send from AI panel", IDC_SEND_SHORTCUT_CHECK, 20, 138, 250, 12, WS_TABSTOP
    LTEXT           "Request timeout (seconds):", IDC_REQUEST_TIMEOUT_LABEL, 20, 158, 110, 10
    EDITTEXT        IDC_REQUEST_TIMEOUT_EDIT, 140, 156, 50, 14, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT           "Local /v1 endpoint:", IDC_LOCAL_COMPATIBLE_ENDPOINT_LABEL, 20, 178, 110, 10
    EDITTEXT        IDC_LOCAL_COMPATIBLE_ENDPOINT_EDIT, 140, 176, 210, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Local API key (optional):", IDC_LOCAL_COMPATIBLE_KEY_LABEL, 20, 198, 110, 10
    EDITTEXT        IDC_LOCAL_COMPATIBLE_KEY_EDIT, 140, 196, 210, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP

    GROUPBOX        "Single-turn Prompt Profile", IDC_PROMPT_PROFILE_GROUP, 10, 222, 360, 90
    LTEXT           "Preset:", IDC_PROMPT_PRESET_LABEL, 20, 238, 100, 10
    COMBOBOX        IDC_PROMPT_PRESET_COMBO, 140, 236, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Response language:", IDC_RESPONSE_LANGUAGE_LABEL, 20, 256, 100, 10
    COMBOBOX        IDC_RESPONSE_LANGUAGE_COMBO, 140, 254, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Encoding suggestion:", IDC_ENCODING_LABEL, 20, 274, 100, 10
    COMBOBOX        IDC_ENCODING_COMBO, 140, 272, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Response detail:", IDC_DETAIL_LEVEL_LABEL, 20, 292, 100, 10
    COMBOBOX        IDC_DETAIL_LEVEL_COMBO, 140, 290, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Scenario Modules", IDC_SCENARIO_GROUP, 10, 320, 360, 58
    AUTOCHECKBOX    "Explain code", IDC_SCENARIO_EXPLAIN_CHECK, 20, 336, 80, 12, WS_TABSTOP
    AUTOCHECKBOX    "Fix bugs", IDC_SCENARIO_FIX_CHECK, 110, 336, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "Refactor", IDC_SCENARIO_REFACTOR_CHECK, 200, 336, 70, 12, WS_TABSTOP
    AUTOCHECKBOX    "Generate tests", IDC_SCENARIO_TEST_CHECK, 20, 352, 90, 12, WS_TABSTOP
    AUTOCHECKBOX    "Write docs", IDC_SCENARIO_DOC_CHECK, 120, 352, 80, 12, WS_TABSTOP

    GROUPBOX        "Output Rules", IDC_OUTPUT_GROUP, 10, 386, 360, 44
    AUTOCHECKBOX    "Code only when suitable", IDC_OUTPUT_CODE_ONLY_CHECK, 20, 402, 100, 12, WS_TABSTOP
    AUTOCHECKBOX    "Preserve project style", IDC_OUTPUT_PRESERVE_STYLE_CHECK, 140, 402, 100, 12, WS_TABSTOP
    AUTOCHECKBOX    "Mention risks and assumptions", IDC_OUTPUT_RISKS_CHECK, 250, 402, 100, 12, WS_TABSTOP

    GROUPBOX        "Prompt Preview", IDC_CUSTOM_PROMPT_GROUP, 10, 438, 360, 110
    EDITTEXT        IDC_CUSTOM_PROMPT_EDIT, 20, 454, 340, 78, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER
    PUSHBUTTON      "Context Templates...", IDC_CONTEXT_TEMPLATES_BUTTON, 20, 534, 104, 12
    PUSHBUTTON      "Memory...", IDC_MEMORY_STORAGE_BUTTON, 132, 534, 110, 12
    PUSHBUTTON      "Prompt Sections...", IDC_PROMPT_SECTIONS_BUTTON, 250, 534, 110, 12

    GROUPBOX        "How to get API Keys", IDC_API_KEYS_GROUP, 10, 554, 360, 52
    LTEXT           "OpenAI: platform.openai.com - API Keys", IDC_API_KEYS_OPENAI_HINT, 20, 568, 330, 10
    LTEXT           "Gemini: ai.google.dev - Get API Key", IDC_API_KEYS_GEMINI_HINT, 20, 580, 330, 10
    LTEXT           "Claude: console.anthropic.com - API Keys", IDC_API_KEYS_CLAUDE_HINT, 20, 592, 330, 10

    PUSHBUTTON      "Test Default Connection", IDC_TEST_CONNECTION_BTN, 10, 616, 110, 20
    DEFPUSHBUTTON   "OK", IDOK, 270, 616, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 320, 616, 50, 20
END

IDD_AIASSISTANT_PROMPT_SECTIONS DIALOGEX 0, 0, 520, 520
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Prompt Sections"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Token:", -1, 10, 12, 35, 10
    COMBOBOX        IDC_PROMPT_SECTION_TOKEN_COMBO, 50, 10, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Insert", IDC_PROMPT_SECTION_INSERT_BUTTON, 210, 9, 45, 14

    AUTOCHECKBOX    "Enable Identity", IDC_IDENTITY_ENABLED_CHECK, 10, 34, 120, 12, WS_TABSTOP
    EDITTEXT        IDC_IDENTITY_TEMPLATE_EDIT, 10, 50, 500, 105, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Reset Identity", IDC_IDENTITY_RESET_BUTTON, 398, 158, 112, 14

    AUTOCHECKBOX    "Enable Rules", IDC_RULES_ENABLED_CHECK, 10, 178, 120, 12, WS_TABSTOP
    EDITTEXT        IDC_RULES_TEMPLATE_EDIT, 10, 194, 500, 105, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Reset Rules", IDC_RULES_RESET_BUTTON, 398, 302, 112, 14

    AUTOCHECKBOX    "Enable Assignment", IDC_ASSIGNMENT_ENABLED_CHECK, 10, 322, 130, 12, WS_TABSTOP
    EDITTEXT        IDC_ASSIGNMENT_TEMPLATE_EDIT, 10, 338, 500, 105, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Reset Assignment", IDC_ASSIGNMENT_RESET_BUTTON, 398, 446, 112, 14

    DEFPUSHBUTTON   "OK", IDOK, 410, 492, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 492, 50, 20
END

IDD_AIASSISTANT_MEMORY_STORAGE DIALOGEX 0, 0, 520, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Memory Storage"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable visible memory section", IDC_MEMORY_ENABLED_CHECK, 10, 12, 160, 12, WS_TABSTOP
    LTEXT           "Memory is stored as plain local plugin settings. Do not store secrets, tokens, passwords, or private customer data.", IDC_MEMORY_WARNING_STATIC, 10, 30, 500, 20
    EDITTEXT        IDC_MEMORY_CONTENT_EDIT, 10, 56, 500, 190, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Clear Memory", IDC_MEMORY_CLEAR_BUTTON, 10, 252, 90, 18
    DEFPUSHBUTTON   "OK", IDOK, 410, 272, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 272, 50, 20
END

IDD_AIASSISTANT_CONTEXT_TEMPLATES DIALOGEX 0, 0, 520, 520
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Context Menu Templates"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable Template 1", IDC_CONTEXT_TEMPLATE1_ENABLED_CHECK, 10, 12, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 32, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE1_NAME_EDIT, 60, 29, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE1_REPLACE_CHECK, 260, 31, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE1_PROMPT_EDIT, 20, 50, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    AUTOCHECKBOX    "Enable Template 2", IDC_CONTEXT_TEMPLATE2_ENABLED_CHECK, 10, 156, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 176, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE2_NAME_EDIT, 60, 173, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE2_REPLACE_CHECK, 260, 175, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE2_PROMPT_EDIT, 20, 194, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    AUTOCHECKBOX    "Enable Template 3", IDC_CONTEXT_TEMPLATE3_ENABLED_CHECK, 10, 300, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 320, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE3_NAME_EDIT, 60, 317, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE3_REPLACE_CHECK, 260, 319, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE3_PROMPT_EDIT, 20, 338, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 410, 492, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 492, 50, 20
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NPPAI_VERSION_MAJOR, NPPAI_VERSION_MINOR, NPPAI_VERSION_PATCH, NPPAI_VERSION_BUILD
 PRODUCTVERSION NPPAI_VERSION_MAJOR, NPPAI_VERSION_MINOR, NPPAI_VERSION_PATCH, NPPAI_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", NPPAI_COMPANY_NAME
            VALUE "FileDescription", NPPAI_FILE_DESCRIPTION
            VALUE "FileVersion", NPPAI_VERSION_STRING_FULL
            VALUE "InternalName", NPPAI_PRODUCT_NAME
            VALUE "LegalCopyright", NPPAI_COPYRIGHT
            VALUE "OriginalFilename", "NppAIAssistant.dll"
            VALUE "ProductName", NPPAI_PRODUCT_NAME
            VALUE "ProductVersion", NPPAI_VERSION_STRING_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
