#include <windows.h>
#include "NppAIAssistantResources.h"
#include "NppAIAssistantVersion.h"

IDD_AIASSISTANT_PANEL DIALOGEX 0, 0, 320, 460
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "NppAIAssistant Workspace"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "NppAIAssistant Workspace", IDC_AI_PANEL_TITLE, 8, 8, 160, 20, SS_LEFT | SS_NOPREFIX | SS_CENTERIMAGE | SS_ENDELLIPSIS
    LTEXT           "Ctrl + Enter to send", IDC_AI_INPUT_HINT, 8, 430, 200, 20, SS_LEFT | SS_NOPREFIX | SS_CENTERIMAGE | SS_ENDELLIPSIS
    COMBOBOX        IDC_AI_PROVIDER_COMBO, 5, 7, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AI_MODEL_COMBO, 138, 7, 70, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sign in", IDC_AI_COPILOT_SIGNIN_BUTTON, 132, 6, 30, 14
    PUSHBUTTON      "A+", IDC_AI_FONT_INCREASE_BUTTON, 166, 6, 18, 14
    PUSHBUTTON      "A-", IDC_AI_FONT_DECREASE_BUTTON, 186, 6, 18, 14
    PUSHBUTTON      "Settings", IDC_AI_SETTINGS_BUTTON, 208, 6, 35, 14
    PUSHBUTTON      "Clear", IDC_AI_CLEAR_BUTTON, 246, 6, 28, 14
    LTEXT           "", IDC_AI_PROVIDER_NAME_STATIC, 5, 23, 270, 18, SS_LEFT | SS_NOPREFIX
    COMBOBOX        IDC_AI_PROFILE_COMBO, 5, 26, 92, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AI_OUTPUT_MODE_COMBO, 100, 26, 82, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Preview", IDC_AI_PREVIEW_CHECK, 185, 28, 52, 12, WS_TABSTOP
    PUSHBUTTON      "New", IDC_AI_NEW_CONVERSATION_BUTTON, 240, 26, 34, 14
    PUSHBUTTON      "Branch", IDC_AI_BRANCH_BUTTON, 240, 43, 34, 14
    COMBOBOX        IDC_AI_PROMPT_ORDER_COMBO, 5, 43, 230, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AI_REQUEST_STATUS_STATIC, 5, 60, 270, 14, SS_LEFT | SS_NOPREFIX | SS_ENDELLIPSIS

    CONTROL         "", IDC_AI_CHAT_HISTORY, "RICHEDIT50W", WS_TABSTOP | WS_CHILD | WS_VISIBLE | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER, 5, 75, 270, 181

    COMBOBOX        IDC_AI_DESTINATION_COMBO, 5, 300, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AI_VIEW_COMBO, 5, 220, 260, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_AI_REPLY_COMBO, 5, 240, 170, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Insert reply", IDC_AI_INSERT_REPLY_BUTTON, 180, 240, 85, 18
    EDITTEXT        IDC_AI_INPUT_EDIT, 5, 260, 220, 35, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER
    LTEXT           "", IDC_AI_INPUT_SPLITTER, 5, 256, 270, 3, SS_GRAYFRAME | SS_NOTIFY
    PUSHBUTTON      "Send", IDC_AI_SEND_BUTTON, 230, 260, 45, 35
END

IDD_AIASSISTANT_SETTINGS DIALOGEX 0, 0, 520, 590
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI Assistant Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "", IDC_SETTINGS_TAB, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 5, 5, 510, 540

    GROUPBOX        "API Keys", IDC_API_KEYS_GROUP, 14, 30, 492, 96
    LTEXT           "OpenAI API Key:", IDC_OPENAI_KEY_LABEL, 24, 47, 94, 10
    EDITTEXT        IDC_OPENAI_KEY_EDIT, 124, 44, 370, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Gemini API Key:", IDC_GEMINI_KEY_LABEL, 24, 67, 94, 10
    EDITTEXT        IDC_GEMINI_KEY_EDIT, 124, 64, 370, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Claude API Key:", IDC_CLAUDE_KEY_LABEL, 24, 87, 94, 10
    EDITTEXT        IDC_CLAUDE_KEY_EDIT, 124, 84, 370, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "OpenRouter API Key:", IDC_OPENROUTER_KEY_LABEL, 24, 107, 94, 10
    EDITTEXT        IDC_OPENROUTER_KEY_EDIT, 124, 104, 370, 14, ES_AUTOHSCROLL | ES_PASSWORD

    GROUPBOX        "OpenAI-compatible service", IDC_COMPATIBLE_GROUP, 14, 132, 492, 190
    LTEXT           "Display name:", IDC_COMPATIBLE_DISPLAY_NAME_LABEL, 24, 150, 104, 10
    EDITTEXT        IDC_COMPATIBLE_DISPLAY_NAME_EDIT, 134, 147, 360, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Base URL:", IDC_COMPATIBLE_BASE_URL_LABEL, 24, 172, 104, 10
    EDITTEXT        IDC_COMPATIBLE_BASE_URL_EDIT, 134, 169, 360, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Optional API key:", IDC_COMPATIBLE_API_KEY_LABEL, 24, 194, 104, 10
    EDITTEXT        IDC_COMPATIBLE_API_KEY_EDIT, 134, 191, 360, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_BORDER | WS_TABSTOP
    LTEXT           "API mode:", IDC_COMPATIBLE_MODE_LABEL, 24, 216, 104, 10
    COMBOBOX        IDC_COMPATIBLE_MODE_COMBO, 134, 213, 160, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Default model:", IDC_COMPATIBLE_DEFAULT_MODEL_LABEL, 24, 239, 104, 10
    COMBOBOX        IDC_COMPATIBLE_DEFAULT_MODEL_COMBO, 134, 236, 250, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Discover models", IDC_COMPATIBLE_DISCOVER_BUTTON, 394, 236, 100, 14
    LTEXT           "No discovery performed.", IDC_COMPATIBLE_DISCOVERY_STATUS, 24, 261, 460, 34

    GROUPBOX        "LM Studio (local loopback)", IDC_LMSTUDIO_GROUP, 14, 330, 492, 194
    LTEXT           "Base URL:", IDC_LMSTUDIO_BASE_URL_LABEL, 24, 350, 104, 10
    EDITTEXT        IDC_LMSTUDIO_BASE_URL_EDIT, 134, 347, 360, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Optional API key:", IDC_LMSTUDIO_API_KEY_LABEL, 24, 372, 104, 10
    EDITTEXT        IDC_LMSTUDIO_API_KEY_EDIT, 134, 369, 360, 14, ES_AUTOHSCROLL | ES_PASSWORD | WS_BORDER | WS_TABSTOP
    LTEXT           "API mode:", IDC_LMSTUDIO_MODE_LABEL, 24, 394, 104, 10
    COMBOBOX        IDC_LMSTUDIO_MODE_COMBO, 134, 391, 160, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Default model:", IDC_LMSTUDIO_DEFAULT_MODEL_LABEL, 24, 417, 104, 10
    COMBOBOX        IDC_LMSTUDIO_DEFAULT_MODEL_COMBO, 134, 414, 250, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Discover models", IDC_LMSTUDIO_DISCOVER_BUTTON, 394, 414, 100, 14
    LTEXT           "No discovery performed.", IDC_LMSTUDIO_STATUS_STATIC, 24, 439, 460, 34

    GROUPBOX        "Default Provider", IDC_DEFAULT_PROVIDER_GROUP, 14, 30, 492, 84
    LTEXT           "Select default AI provider:", IDC_DEFAULT_PROVIDER_LABEL, 24, 48, 124, 10
    COMBOBOX        IDC_DEFAULT_PROVIDER_COMBO, 154, 45, 180, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Language:", IDC_UI_LANGUAGE_LABEL, 24, 70, 124, 10
    COMBOBOX        IDC_UI_LANGUAGE_COMBO, 154, 67, 180, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Require Ctrl+Enter to send from AI panel", IDC_SEND_SHORTCUT_CHECK, 24, 92, 250, 12, WS_TABSTOP
    LTEXT           "Menu modifier:", IDC_CONTEXT_MENU_MODIFIER_LABEL, 350, 48, 112, 10
    COMBOBOX        IDC_CONTEXT_MENU_MODIFIER_COMBO, 350, 64, 144, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Single-turn Prompt Profile", IDC_PROMPT_PROFILE_GROUP, 14, 122, 492, 124
    LTEXT           "Preset:", IDC_PROMPT_PRESET_LABEL, 24, 140, 110, 10
    COMBOBOX        IDC_PROMPT_PRESET_COMBO, 154, 137, 190, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Response language:", IDC_RESPONSE_LANGUAGE_LABEL, 24, 160, 110, 10
    COMBOBOX        IDC_RESPONSE_LANGUAGE_COMBO, 154, 157, 150, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Encoding suggestion:", IDC_ENCODING_LABEL, 24, 180, 110, 10
    COMBOBOX        IDC_ENCODING_COMBO, 154, 177, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Response detail:", IDC_DETAIL_LEVEL_LABEL, 324, 160, 100, 10
    COMBOBOX        IDC_DETAIL_LEVEL_COMBO, 324, 177, 170, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Output format:", IDC_OUTPUT_MODE_LABEL, 24, 202, 110, 10
    COMBOBOX        IDC_OUTPUT_MODE_COMBO, 154, 199, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Structured schema:", IDC_STRUCTURED_SCHEMA_LABEL, 324, 202, 100, 10
    COMBOBOX        IDC_STRUCTURED_SCHEMA_COMBO, 324, 199, 170, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Strict schema", IDC_STRUCTURED_STRICT_CHECK, 154, 224, 100, 12, WS_TABSTOP
    AUTOCHECKBOX    "Validate response", IDC_STRUCTURED_VALIDATE_CHECK, 270, 224, 110, 12, WS_TABSTOP

    GROUPBOX        "Scenario Modules", IDC_SCENARIO_GROUP, 14, 252, 492, 54
    AUTOCHECKBOX    "Explain code", IDC_SCENARIO_EXPLAIN_CHECK, 24, 270, 86, 12, WS_TABSTOP
    AUTOCHECKBOX    "Fix bugs", IDC_SCENARIO_FIX_CHECK, 116, 270, 72, 12, WS_TABSTOP
    AUTOCHECKBOX    "Refactor", IDC_SCENARIO_REFACTOR_CHECK, 196, 270, 72, 12, WS_TABSTOP
    AUTOCHECKBOX    "Generate tests", IDC_SCENARIO_TEST_CHECK, 276, 270, 94, 12, WS_TABSTOP
    AUTOCHECKBOX    "Write docs", IDC_SCENARIO_DOC_CHECK, 380, 270, 82, 12, WS_TABSTOP

    GROUPBOX        "Output Rules", IDC_OUTPUT_GROUP, 14, 314, 492, 44
    AUTOCHECKBOX    "Code only when suitable", IDC_OUTPUT_CODE_ONLY_CHECK, 24, 332, 120, 12, WS_TABSTOP
    AUTOCHECKBOX    "Preserve project style", IDC_OUTPUT_PRESERVE_STYLE_CHECK, 168, 332, 120, 12, WS_TABSTOP
    AUTOCHECKBOX    "Mention risks and assumptions", IDC_OUTPUT_RISKS_CHECK, 314, 332, 172, 12, WS_TABSTOP

    GROUPBOX        "Prompt Preview", IDC_CUSTOM_PROMPT_GROUP, 14, 366, 492, 154
    EDITTEXT        IDC_CUSTOM_PROMPT_EDIT, 24, 384, 472, 86, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_BORDER
    LTEXT           "The final prompt can be edited in full before sending. Generated sections are shown as read-only in Prompt Sections.", IDC_PROMPT_MANUAL_NOTE, 24, 474, 472, 18
    PUSHBUTTON      "Context Templates...", IDC_CONTEXT_TEMPLATES_BUTTON, 24, 496, 124, 16
    PUSHBUTTON      "Memory...", IDC_MEMORY_STORAGE_BUTTON, 158, 496, 104, 16
    PUSHBUTTON      "Prompt Sections...", IDC_PROMPT_SECTIONS_BUTTON, 272, 496, 128, 16

    PUSHBUTTON      "Test Default Connection", IDC_TEST_CONNECTION_BTN, 10, 558, 130, 20
    DEFPUSHBUTTON   "OK", IDOK, 402, 558, 50, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 458, 558, 52, 20
END

IDD_AIASSISTANT_PROMPT_SECTIONS DIALOGEX 0, 0, 620, 480
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Prompt Sections"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Section:", IDC_PROMPT_SECTION_SELECTOR_LABEL, 10, 13, 48, 10
    COMBOBOX        IDC_PROMPT_SECTION_SELECTOR_COMBO, 62, 10, 260, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Included in this preview", IDC_PROMPT_SECTION_STATUS_STATIC, 330, 11, 280, 18, SS_RIGHT | SS_NOPREFIX | SS_ENDELLIPSIS

    AUTOCHECKBOX    "Include this editable section", IDC_PROMPT_SECTION_ENABLED_CHECK, 10, 40, 180, 12, WS_TABSTOP
    AUTOCHECKBOX    "Locked", IDC_PROMPT_SECTION_LOCK_CHECK, 200, 40, 96, 12, WS_TABSTOP
    PUSHBUTTON      "Reset to default", IDC_PROMPT_SECTION_RESET_BUTTON, 500, 36, 108, 18
    EDITTEXT        IDC_PROMPT_SECTION_CONTENT_EDIT, 10, 62, 598, 310, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Generated sections are read-only here, but remain copyable. The final Composer prompt is always fully editable before sending.", IDC_PROMPT_SECTION_LOCKED_HINT, 10, 378, 598, 28

    LTEXT           "Token:", IDC_PROMPT_SECTION_TOKEN_LABEL, 10, 416, 42, 10
    COMBOBOX        IDC_PROMPT_SECTION_TOKEN_COMBO, 58, 413, 180, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Insert", IDC_PROMPT_SECTION_INSERT_BUTTON, 246, 412, 52, 16
    PUSHBUTTON      "Edit Memory...", IDC_PROMPT_SECTION_EDIT_MEMORY_BUTTON, 306, 412, 92, 16

    DEFPUSHBUTTON   "OK", IDOK, 508, 450, 48, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 560, 450, 50, 20
END

IDD_AIASSISTANT_MEMORY_STORAGE DIALOGEX 0, 0, 520, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Memory Storage"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable visible memory section", IDC_MEMORY_ENABLED_CHECK, 10, 12, 160, 12, WS_TABSTOP
    LTEXT           "Memory is stored as plain local plugin settings. Do not store secrets, tokens, passwords, or private customer data.", IDC_MEMORY_WARNING_STATIC, 10, 30, 500, 20
    EDITTEXT        IDC_MEMORY_CONTENT_EDIT, 10, 56, 500, 190, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Clear Memory", IDC_MEMORY_CLEAR_BUTTON, 10, 252, 90, 18
    DEFPUSHBUTTON   "OK", IDOK, 410, 272, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 272, 50, 20
END

IDD_AIASSISTANT_CONTEXT_TEMPLATES DIALOGEX 0, 0, 520, 520
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Context Menu Templates"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    AUTOCHECKBOX    "Enable Template 1", IDC_CONTEXT_TEMPLATE1_ENABLED_CHECK, 10, 12, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 32, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE1_NAME_EDIT, 60, 29, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE1_REPLACE_CHECK, 260, 31, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE1_PROMPT_EDIT, 20, 50, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    AUTOCHECKBOX    "Enable Template 2", IDC_CONTEXT_TEMPLATE2_ENABLED_CHECK, 10, 156, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 176, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE2_NAME_EDIT, 60, 173, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE2_REPLACE_CHECK, 260, 175, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE2_PROMPT_EDIT, 20, 194, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    AUTOCHECKBOX    "Enable Template 3", IDC_CONTEXT_TEMPLATE3_ENABLED_CHECK, 10, 300, 120, 12, WS_TABSTOP
    LTEXT           "Name:", -1, 20, 320, 40, 10
    EDITTEXT        IDC_CONTEXT_TEMPLATE3_NAME_EDIT, 60, 317, 180, 14, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    AUTOCHECKBOX    "Replace selection", IDC_CONTEXT_TEMPLATE3_REPLACE_CHECK, 260, 319, 110, 12, WS_TABSTOP
    EDITTEXT        IDC_CONTEXT_TEMPLATE3_PROMPT_EDIT, 20, 338, 490, 92, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 410, 492, 45, 20
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 492, 50, 20
END

IDD_AIASSISTANT_PROMPT_COMPOSER DIALOGEX 0, 0, 520, 410
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Compose AI Prompt"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Preset:", IDC_COMPOSER_PRESET_LABEL, 10, 12, 44, 10
    COMBOBOX        IDC_COMPOSER_PRESET_COMBO, 58, 10, 160, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Code only when suitable", IDC_COMPOSER_OUTPUT_CODE_ONLY_CHECK, 235, 12, 112, 12, WS_TABSTOP
    AUTOCHECKBOX    "Preserve project style", IDC_COMPOSER_OUTPUT_PRESERVE_STYLE_CHECK, 350, 12, 110, 12, WS_TABSTOP
    AUTOCHECKBOX    "Mention risks", IDC_COMPOSER_OUTPUT_RISKS_CHECK, 235, 28, 100, 12, WS_TABSTOP

    EDITTEXT        IDC_COMPOSER_RUNTIME_POLICY_STATIC, 10, 48, 500, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Task Instructions (editable):", IDC_COMPOSER_FINAL_PROMPT_LABEL, 10, 104, 240, 10
    EDITTEXT        IDC_COMPOSER_FINAL_PROMPT_EDIT, 10, 118, 500, 220, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Policy summary", IDC_COMPOSER_STATUS_STATIC, 10, 346, 390, 12
    PUSHBUTTON      "Restore Task Instructions", IDC_COMPOSER_REBUILD_BUTTON, 10, 370, 140, 18
    DEFPUSHBUTTON   "Send", IDOK, 410, 370, 45, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 462, 370, 48, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NPPAI_VERSION_MAJOR, NPPAI_VERSION_MINOR, NPPAI_VERSION_PATCH, NPPAI_VERSION_BUILD
 PRODUCTVERSION NPPAI_VERSION_MAJOR, NPPAI_VERSION_MINOR, NPPAI_VERSION_PATCH, NPPAI_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", NPPAI_COMPANY_NAME
            VALUE "FileDescription", NPPAI_FILE_DESCRIPTION
            VALUE "FileVersion", NPPAI_VERSION_STRING_FULL
            VALUE "InternalName", NPPAI_PRODUCT_NAME
            VALUE "LegalCopyright", NPPAI_COPYRIGHT
            VALUE "OriginalFilename", "NppAIAssistant.dll"
            VALUE "ProductName", NPPAI_PRODUCT_NAME
            VALUE "ProductVersion", NPPAI_VERSION_STRING_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
